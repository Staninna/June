<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Local AI pairing token: must never leave the device. -->
        <exclude domain="sharedpref" path="local_ai.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="local_ai.xml" />
    </device-transfer>
</data-extraction-rules>
